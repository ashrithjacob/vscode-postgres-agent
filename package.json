{
  "name": "vscode-postgres-agent",
  "displayName": "PostgreSQL Agent",
  "description": "Query PostgreSQL databases using natural language powered by AI",
  "version": "1.0.0",
  "publisher": "ashrithjacob",
  "license": "MIT",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashrithjacob/vscode-postgres-agent"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "postgres-agent",
          "title": "PostgreSQL Agent",
          "icon": "resources/database.svg"
        }
      ]
    },
    "views": {
      "postgres-agent": [
        {
          "id": "postgresConnections",
          "name": "Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "postgres-agent.configure",
        "title": "Postgres Agent: Configure LLM"
      },
      {
        "command": "postgres-agent.connect",
        "title": "Postgres Agent: Connect to Database"
      },
      {
        "command": "postgres-agent.query",
        "title": "Postgres Agent: Open Query Panel"
      },
      {
        "command": "postgres-agent.disconnect",
        "title": "Postgres Agent: Disconnect"
      },
      {
        "command": "postgres-agent.saveConnection",
        "title": "Save Connection"
      },
      {
        "command": "postgres-agent.connectSaved",
        "title": "Connect"
      },
      {
        "command": "postgres-agent.deleteConnection",
        "title": "Delete Connection",
        "icon": "$(trash)"
      },
      {
        "command": "postgres-agent.renameConnection",
        "title": "Rename Connection",
        "icon": "$(edit)"
      },
      {
        "command": "postgres-agent.clearHistory",
        "title": "Clear Chat History",
        "icon": "$(clear-all)"
      },
      {
        "command": "postgres-agent.refreshConnections",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "postgres-agent.refreshConnections",
          "when": "view == postgresConnections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "postgres-agent.connectSaved",
          "when": "view == postgresConnections && viewItem == savedConnection",
          "group": "1_connection"
        },
        {
          "command": "postgres-agent.renameConnection",
          "when": "view == postgresConnections && viewItem == savedConnection",
          "group": "2_edit"
        },
        {
          "command": "postgres-agent.clearHistory",
          "when": "view == postgresConnections && viewItem == savedConnection",
          "group": "2_edit"
        },
        {
          "command": "postgres-agent.deleteConnection",
          "when": "view == postgresConnections && viewItem == savedConnection",
          "group": "3_delete"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "build:vsix": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "pg": "^8.11.3"
  }
}
